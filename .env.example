# my.telegram.org → API development tools (идентифицируют «приложение», не дают доступ к аккаунту)
TG_API_ID=
TG_API_HASH=

# Индексируемая группа: -100…id (надёжнее всего; подобрать: uv run python -m app.chats) или @username
TG_TARGET_CHAT=

# Бот-интерфейс (@BotFather)
TG_BOT_TOKEN=

# Личка: id через запятую и/или "group" — пускать всех участников индексируемой группы.
# Пусто — бот в ответ сообщает user id написавшего и больше ничего не делает.
TG_ALLOWED_IDS=

CLAUDE_MODEL=sonnet
SESSION_FRESH_HOURS=6
